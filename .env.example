# Cartwise — copy to .env.local and fill in. Never commit .env.local

# Database (Neon Postgres — use the POOLED connection string)
DATABASE_URL=

# NextAuth / Auth.js v5
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (required)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional — provider only loads if both are set)
GITHUB_ID=
GITHUB_SECRET=

# USDA FoodData Central — free key: https://fdc.nal.usda.gov/api-key-signup
USDA_FDC_API_KEY=
