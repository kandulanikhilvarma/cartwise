# Cartwise — copy to .env and fill in. Never commit real secrets.

# Database (Neon/Supabase Postgres). Use DIRECT (:5432) for migrations,
# POOLED for serverless runtime. Leave blank to run against an in-memory
# store — the flow works, nothing persists between restarts.
DATABASE_URL=

# NextAuth / Auth.js v5 (generate: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (required)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional — provider only loads if both are set)
GITHUB_ID=
GITHUB_SECRET=

# USDA FoodData Central — free key: https://fdc.nal.usda.gov/api-key-signup
# Without it, Open Food Facts alone is used and match quality drops.
USDA_FDC_API_KEY=

# Canonical origin for metadata, sitemap and OG images.
# Unset on Vercel, the deployment URL is used.
NEXT_PUBLIC_SITE_URL=

# Optional. Without these the rate limiter is per-instance, which does not
# actually bound a multi-instance serverless deployment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
