# Cartwise — copy to .env and fill in. Never commit real secrets.

# Database (Supabase/Neon Postgres). Use DIRECT (:5432) for migrations,
# POOLED for serverless runtime.
DATABASE_URL=

# NextAuth / Auth.js v5 (generate: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (required)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional — provider only loads if both are set)
GITHUB_ID=
GITHUB_SECRET=

# USDA FoodData Central — free key: https://fdc.nal.usda.gov/api-key-signup
USDA_FDC_API_KEY=
