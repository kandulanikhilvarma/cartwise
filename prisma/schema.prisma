generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String        @id @default(cuid())
  email     String        @unique
  name      String?
  image     String?
  createdAt DateTime      @default(now())
  groceries GroceryBatch[]
}

model GroceryBatch {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchasedAt     DateTime      @default(now())
  storeName       String?
  receiptImageUrl String?
  ocrStatus       String        @default("pending")
  items           GroceryItem[]
  createdAt       DateTime      @default(now())

  @@index([userId, createdAt])
}

model GroceryItem {
  id              String       @id @default(cuid())
  batchId         String
  batch           GroceryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  productName     String
  quantity        Float        @default(1)
  unit            String?
  barcodeId       String?
  matchedFoodId   String?
  matchConfidence Float?
  caloriesKcal    Float?
  proteinG        Float?
  carbsG          Float?
  fatG            Float?
  sodiumMg        Float?
  vitaminDMcg     Float?
  ironMg          Float?
  calciumMg       Float?
  consumed        Boolean      @default(false)
  consumedAt      DateTime?
}

// Auth.js uses JWT sessions (no database adapter), so no Account/Session/
// VerificationToken tables are needed. Add them back with a PrismaAdapter if
// database sessions or persisted OAuth tokens become necessary.
